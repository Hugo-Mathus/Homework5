@startuml
object "<u>php_demo1 : Folder</u>" as php_demo1{
    name = php_demo1
    Folders[Source Files] subFolders
    Files[] files
}

object "<u>Source Files : Folder</u>" as Source_Files{
    name = Source_Files
    Folders[.phalcon, cache, public] subFolders
    Files[] files
}
object "<u>.phalcon : Folder</u>" as .phalcon{
    name = .phalcon
    Folders[Source Files] subFolders
    Files[] files
}
object "<u>cache : Folder</u>" as cache{
    name = cache
    Folders[] subFolders
    Files[] files
}
object "<u> public : Folder</u>" as public{
    name = public
    Folders[] subFolders
    Files[.htaccess, .htrouter.php, index.html] files
}

object "<u>.htaccess : File</u>" as .htaccess{
    name = .htaccess
}
object "<u>.htrouter.php : File</u>" as .htrouter{
    name = .htrouter.php
}
object "<u>index.html : File</u>" as index{
    name = index.html
}


php_demo1*--Source_Files

Source_Files*--phalcon
Source_Files*--cache
Source_Files*--public

public*-- .htaccess
public*-- .htrouter
public *-- index

@enduml